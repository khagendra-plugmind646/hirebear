# MongoDB
MONGODB_URI=mongodb://localhost:27017/hirebear

# NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Cashfree (get from Cashfree merchant dashboard)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX
CASHFREE_WEBHOOK_SECRET=

# Razorpay (get from Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# File storage. "local" reads .xlsx files bundled in private-files/ at the
# project root (fine for launch). Switch to "s3" once you add real object
# storage and implement it in src/services/FileStorageService.ts.
STORAGE_PROVIDER=local
PRIVATE_FILES_DIR=./private-files
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=hello@hirebear.in
RESEND_API_KEY=

APP_URL=http://localhost:3000
